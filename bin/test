#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

PROFILE="${1:-quick}"

usage() {
    cat <<'USAGE'
Usage: ./bin/test [quick|full|ci|coverage|mutation|contracts|e2e|ui]

Profiles:
  quick      syntax + unit + integration (no coverage)
  full       quick + contracts + phpstan
  ci         full + coverage report (minimum 85% line coverage)
  coverage   phpunit with coverage artifacts (minimum 85% line coverage)
  mutation   Infection against src/PFrame.php (requires PCOV or Xdebug)
  contracts  contract/governance tests
  e2e        unsupported for pframe (returns exit code 2)
  ui         unsupported for pframe (returns exit code 2)
USAGE
}

if [[ "$PROFILE" == "--help" || "$PROFILE" == "-h" ]]; then
    usage
    exit 0
fi

step() {
    local label="$1"
    echo "step=$label"
}

step_result() {
    local label="$1"
    local status="$2"
    local started_at="$3"
    local finished_at
    local duration

    finished_at="$(date +%s)"
    duration=$((finished_at - started_at))
    echo "status=$status duration=${duration}s step=$label"
}

run_step() {
    local label="$1"
    shift

    local started_at
    started_at="$(date +%s)"

    step "$label"
    if "$@"; then
        step_result "$label" "ok" "$started_at"
        return 0
    fi

    step_result "$label" "fail" "$started_at"
    return 1
}

run_php_lint() {
    local file

    while IFS= read -r -d '' file; do
        php -l "$file" > /dev/null
    done < <(find src tests -type f -name '*.php' -print0)
}

run_quick() {
    run_step "Syntax check" run_php_lint
    run_step "Unit tests" composer test:unit
    run_step "Integration tests" composer test:integration
}

consumer_copy_present() {
    local consumer_root="$1"

    find "$consumer_root" \
        -mindepth 3 \
        -maxdepth 4 \
        -type f \
        \( -path '*/lib/PFrame.php' -o -path '*/app/lib/PFrame.php' \) \
        -print -quit | grep -q .
}

run_consumer_check() {
    local consumer_root="${PFRAME_CONSUMER_ROOT:-$(dirname "$ROOT_DIR")}"

    if [[ ! -d "$consumer_root" ]]; then
        echo "Consumer root does not exist: $consumer_root" >&2
        return 1
    fi

    if ! consumer_copy_present "$consumer_root"; then
        echo "No external consumer copies found under $consumer_root; fixture contract runs in Contracts."
        return 0
    fi

    "$ROOT_DIR/bin/check-consumers.sh" "$consumer_root"
}

run_contracts() {
    run_step "Contracts tests" composer test:contracts
    run_step "Consumer copies" run_consumer_check
}

run_full() {
    run_quick
    run_contracts
    run_step "Static analysis (phpstan)" composer phpstan
}

coverage_driver_available() {
    if [[ "${PFRAME_FORCE_NO_COVERAGE:-0}" == "1" ]]; then
        return 1
    fi

    php -r 'exit((extension_loaded("xdebug") || extension_loaded("pcov")) ? 0 : 1);'
}

check_coverage_threshold() {
    local report="build/coverage/clover.xml"
    local minimum="85"

    php -r '
        $report = $argv[1];
        $minimum = (float) $argv[2];
        $xml = is_file($report) ? simplexml_load_file($report) : false;
        if ($xml === false || !isset($xml->project->metrics)) {
            fwrite(STDERR, "Coverage report missing or invalid: {$report}\n");
            exit(1);
        }
        $metrics = $xml->project->metrics;
        $total = (int) $metrics["statements"];
        $covered = (int) $metrics["coveredstatements"];
        if ($total <= 0) {
            fwrite(STDERR, "Coverage report contains no executable lines.\n");
            exit(1);
        }
        $percent = ($covered / $total) * 100;
        printf("Line coverage: %.2f%% (%d/%d), required: %.2f%%\n", $percent, $covered, $total, $minimum);
        exit($percent + 0.00001 >= $minimum ? 0 : 1);
    ' "$report" "$minimum"
}

run_coverage() {
    mkdir -p build/coverage

    if coverage_driver_available; then
        run_step "Coverage report" env XDEBUG_MODE=coverage vendor/bin/phpunit --testsuite Unit,Integration,Contracts --coverage-text --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html
        run_step "Coverage threshold" check_coverage_threshold
        return
    fi

    if [[ "${PFRAME_FORCE_NO_COVERAGE:-0}" != "1" ]] && command -v phpdbg >/dev/null 2>&1; then
        run_step "Coverage report" phpdbg -qrr vendor/bin/phpunit --testsuite Unit,Integration,Contracts --coverage-text --coverage-clover build/coverage/clover.xml --coverage-html build/coverage/html
        run_step "Coverage threshold" check_coverage_threshold
        return
    fi

    step "Coverage report"
    echo "Coverage driver unavailable (xdebug/pcov/phpdbg)."
    echo "status=fail duration=0s step=Coverage report"
    return 1
}

run_mutation() {
    local infection="$ROOT_DIR/tools/infection/vendor/bin/infection"

    if [[ ! -x "$infection" ]]; then
        step "Mutation tests"
        echo "Mutation tool unavailable. Run: composer install --working-dir=tools/infection" >&2
        echo "status=fail duration=0s step=Mutation tests"
        return 1
    fi

    if ! coverage_driver_available; then
        step "Mutation tests"
        echo "Mutation coverage driver unavailable (xdebug/pcov)." >&2
        echo "status=fail duration=0s step=Mutation tests"
        return 1
    fi

    if ! command -v nice >/dev/null 2>&1; then
        step "Mutation tests"
        echo "Mutation niceness utility unavailable (nice)." >&2
        echo "status=fail duration=0s step=Mutation tests"
        return 1
    fi

    if ! command -v flock >/dev/null 2>&1; then
        step "Mutation tests"
        echo "Mutation lock utility unavailable (flock)." >&2
        echo "status=fail duration=0s step=Mutation tests"
        return 1
    fi

    mkdir -p build/infection
    local lock_file="$ROOT_DIR/build/infection/.lock"
    local lock_fd
    if ! exec {lock_fd}>"$lock_file"; then
        step "Mutation tests"
        echo "Mutation lock cannot be opened: $lock_file" >&2
        echo "status=fail duration=0s step=Mutation tests"
        return 1
    fi
    if ! flock "$lock_fd"; then
        step "Mutation tests"
        echo "Mutation lock cannot be acquired: $lock_file" >&2
        echo "status=fail duration=0s step=Mutation tests"
        exec {lock_fd}>&-
        return 1
    fi

    local result=0
    local initial_tests_php_options="-d pcov.enabled=1 -d pcov.directory=$ROOT_DIR/src -d xdebug.mode=coverage"
    run_step "Mutation tests" nice -n 19 env XDEBUG_MODE=coverage php -d memory_limit=1G "$infection" \
        --configuration="$ROOT_DIR/infection.json5" \
        --no-interaction \
        --with-uncovered \
        --only-covering-test-cases \
        --initial-tests-php-options="$initial_tests_php_options" \
        --threads=1 \
        "${@:2}" || result=$?
    flock -u "$lock_fd" || true
    exec {lock_fd}>&-
    return "$result"
}

run_unsupported() {
    local label="$1"
    step "$label"
    echo "Profile is unsupported for pframe (framework-level repository)." >&2
    echo "status=unsupported duration=0s step=$label" >&2
    return 2
}

case "$PROFILE" in
    quick)
        run_quick
        ;;
    full)
        run_full
        ;;
    ci)
        run_full
        run_coverage
        ;;
    coverage)
        run_coverage
        ;;
    mutation)
        run_mutation "$@"
        ;;
    contracts)
        run_contracts
        ;;
    e2e)
        run_unsupported "E2E tests (unsupported)"
        ;;
    ui)
        run_unsupported "UI tests (unsupported)"
        ;;
    *)
        usage
        exit 1
        ;;
esac
