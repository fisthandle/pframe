{
    "name": "pframe/framework",
    "description": "Single-file PHP 8.4+ micro-framework",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-pdo_mysql": "Required when PFrame uses MySQL or MariaDB",
        "ext-pdo_sqlite": "Required when PFrame uses SQLite"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "files": [
            "src/PFrame.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PFrame\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/.*",
            "/*",
            "!/LICENSE",
            "!/README.md",
            "!/composer.json",
            "!/db",
            "!/docs",
            "!/src",
            "/docs/plans"
        ]
    },
    "scripts": {
        "test": "./bin/test quick",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "test:contracts": "phpunit --testsuite Contracts",
        "test:quick": "./bin/test quick",
        "test:full": "./bin/test full",
        "test:ci": "./bin/test ci",
        "test:coverage": "./bin/test coverage",
        "phpstan": "phpstan analyse"
    }
}
