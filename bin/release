#!/usr/bin/env bash
# Wydaje bieżący commit PFrame do konsumentów: kopiuje src/PFrame.php (i PFrameTesting.php,
# jeśli konsument go używa), zapisuje wydany SHA w lib/PFRAME_VERSION, uruchamia bramkę
# konsumenta (`composer test:pframe`, a bez takiego skryptu `composer test`) i commituje kopię.
# Przy błędzie bramki kopia jest cofana. Deploy konsumentów pozostaje ich własną procedurą.
set -euo pipefail

PFRAME_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=consumers.sh
source "$PFRAME_DIR/bin/consumers.sh"

usage() {
    echo "Usage: $0 [--push] [--dev-dir DIR] [consumer ...]"
    echo "Bez nazw konsumentów wydaje do wszystkich nieaktualnych."
}

PUSH=0
DEV_DIR="$(dirname "$PFRAME_DIR")"
SELECTED=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --push) PUSH=1 ;;
        --dev-dir) DEV_DIR="$2"; shift ;;
        -h|--help) usage; exit 0 ;;
        -*) usage; exit 2 ;;
        *) SELECTED+=("$1") ;;
    esac
    shift
done
DEV_DIR="$(cd "$DEV_DIR" && pwd)"

if [[ -n "$(git -C "$PFRAME_DIR" status --porcelain)" ]]; then
    echo "PFrame ma niezacommitowane zmiany; wydawany może być tylko commit." >&2
    exit 1
fi
git -C "$PFRAME_DIR" fetch --quiet origin
if ! git -C "$PFRAME_DIR" merge-base --is-ancestor HEAD origin/main; then
    echo "HEAD PFrame nie jest w origin/main; najpierw wypchnij commit." >&2
    exit 1
fi

echo "== PFrame: testy"
(cd "$PFRAME_DIR" && bin/test quick >/dev/null && composer phpstan >/dev/null)

SHA="$(git -C "$PFRAME_DIR" rev-parse --short HEAD)"
SUBJECT="$(git -C "$PFRAME_DIR" log -1 --format=%s)"

declare -A LIB_DIRS=()
while IFS= read -r -d '' lib_dir; do
    LIB_DIRS["$(pframe_consumer_name "$DEV_DIR" "$lib_dir")"]="$lib_dir"
done < <(pframe_consumer_lib_dirs "$DEV_DIR")

if [[ ${#SELECTED[@]} -eq 0 ]]; then
    mapfile -t SELECTED < <(printf '%s\n' "${!LIB_DIRS[@]}" | sort)
fi
for name in "${SELECTED[@]}"; do
    if [[ -z "${LIB_DIRS[$name]:-}" ]]; then
        echo "Nie znaleziono konsumenta: $name" >&2
        exit 1
    fi
done

# Kopia w toku jest cofana przy każdym przerwaniu: błąd testów, hook commita, Ctrl-C.
pending_repo=""
pending_files=()
pending_new_file=""
rollback() {
    if [[ -n "$pending_repo" ]]; then
        git -C "$pending_repo" checkout HEAD -- "${pending_files[@]}"
        if [[ -n "$pending_new_file" ]]; then
            git -C "$pending_repo" rm --quiet --cached --ignore-unmatch -- "$pending_new_file"
            rm -f "$pending_new_file"
        fi
    fi
    pending_repo=""
}
trap 'rollback; exit 130' INT TERM
trap rollback EXIT

failed=()
for name in "${SELECTED[@]}"; do
    lib_dir="${LIB_DIRS[$name]}"
    files=("$lib_dir/PFrame.php")
    [[ -f "$lib_dir/PFrameTesting.php" ]] && files+=("$lib_dir/PFrameTesting.php")
    repo="$(git -C "$lib_dir" rev-parse --show-toplevel)"
    outdated=0
    for file in "${files[@]}"; do
        cmp -s "$PFRAME_DIR/src/$(basename "$file")" "$file" || outdated=1
    done
    if [[ $outdated -eq 0 ]]; then
        if [[ $PUSH -eq 1 ]]; then
            if ! upstream="$(git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"; then
                echo "== $name: POMINIĘTY — gałąź bez upstreamu, publikacji release nie można potwierdzić"
                failed+=("$name")
                continue
            fi
            if ! git -C "$repo" merge-base --is-ancestor HEAD "$upstream"; then
                echo "== $name: POMINIĘTY — lokalny HEAD nie jest opublikowany; push pominięty"
                failed+=("$name")
                continue
            fi
        fi
        echo "== $name: aktualny"
        continue
    fi

    if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
        echo "== $name: POMINIĘTY — niezacommitowane zmiany w $repo"
        failed+=("$name")
        continue
    fi
    if [[ $PUSH -eq 1 ]] && ! git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        echo "== $name: POMINIĘTY — gałąź bez upstreamu, --push niemożliwy"
        failed+=("$name")
        continue
    fi

    gate="test"
    if php -r 'exit(isset(json_decode((string) file_get_contents($argv[1]), true)["scripts"]["test:pframe"]) ? 0 : 1);' \
        "$repo/composer.json" 2>/dev/null; then
        gate="test:pframe"
    fi
    version_file="$lib_dir/PFRAME_VERSION"

    echo "== $name: kopia $SHA i bramka composer $gate"
    pending_repo="$repo"
    pending_files=("${files[@]}")
    pending_new_file="$version_file"
    if git -C "$repo" ls-files --error-unmatch -- "$version_file" >/dev/null 2>&1; then
        pending_files+=("$version_file")
        pending_new_file=""
    fi
    for file in "${files[@]}"; do
        cp "$PFRAME_DIR/src/$(basename "$file")" "$file"
    done
    git -C "$PFRAME_DIR" rev-parse HEAD > "$version_file"
    files+=("$version_file")
    log="$(mktemp -t "pframe-release-${name//\//-}-XXXX.log")"
    if ! (cd "$repo" && composer "$gate") >"$log" 2>&1; then
        rollback
        echo "   BŁĄD testów ($gate), kopia cofnięta; log: $log"
        failed+=("$name")
        continue
    fi
    if ! git -C "$repo" add -- "$version_file" >>"$log" 2>&1 \
        || ! git -C "$repo" commit --quiet -m "Update PFrame to $SHA" -m "$SUBJECT" -- "${files[@]}" >>"$log" 2>&1; then
        rollback
        echo "   BŁĄD commita (hook?), kopia cofnięta; log: $log"
        failed+=("$name")
        continue
    fi
    pending_repo=""
    echo "   commit $(git -C "$repo" rev-parse --short HEAD) na $(git -C "$repo" branch --show-current)"
    if [[ $PUSH -eq 1 ]]; then
        if git -C "$repo" push --quiet >>"$log" 2>&1; then
            echo "   wypchnięty"
        else
            echo "   BŁĄD push (commit zostaje lokalnie); log: $log"
            failed+=("$name")
        fi
    fi
done

if [[ ${#failed[@]} -gt 0 ]]; then
    echo "Niewydane: ${failed[*]}" >&2
    exit 1
fi
